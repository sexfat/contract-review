{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClassifiedClauseListResponse",
  "type": "object",
  "required": ["document_id", "status", "clauses"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "status": {"const": "classified"},
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "clause_id",
          "clause_type",
          "original_text",
          "location",
          "plain_summary",
          "confidence"
        ],
        "properties": {
          "clause_id": {"type": "string", "minLength": 1},
          "clause_type": {
            "enum": [
              "scope",
              "acceptance",
              "payment",
              "ip",
              "warranty",
              "liability",
              "termination",
              "penalty",
              "confidentiality",
              "other"
            ]
          },
          "original_text": {"type": "string", "minLength": 1},
          "location": {
            "type": "object",
            "required": ["source_start_index", "source_end_index", "paragraph_ids"],
            "properties": {
              "article_no": {"type": ["string", "null"]},
              "heading": {"type": ["string", "null"]},
              "source_start_index": {"type": "integer", "minimum": 0},
              "source_end_index": {"type": "integer", "minimum": 0},
              "paragraph_ids": {"type": "array", "items": {"type": "string"}},
              "table_refs": {"type": "array", "items": {"type": "string"}}
            }
          },
          "plain_summary": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "requires_human_review": {"type": "boolean"},
          "model_id": {"type": ["string", "null"]}
        }
      }
    }
  }
}
