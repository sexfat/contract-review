{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewReport",
  "type": "object",
  "required": ["document_id", "contract_title", "overall_summary", "disclaimer", "clauses", "risks"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "contract_title": {"type": "string", "minLength": 1},
    "overall_summary": {"type": "string", "minLength": 1},
    "disclaimer": {"type": "string", "minLength": 1},
    "clauses": {
      "type": "array",
      "items": {"$ref": "#/$defs/extractedClause"}
    },
    "risks": {
      "type": "array",
      "items": {"$ref": "#/$defs/riskAssessment"}
    }
  },
  "$defs": {
    "extractedClause": {
      "type": "object",
      "required": [
        "clause_id",
        "clause_type",
        "original_text",
        "location",
        "plain_summary",
        "confidence"
      ],
      "properties": {
        "clause_id": {"type": "string", "minLength": 1},
        "clause_type": {"$ref": "#/$defs/clauseType"},
        "original_text": {"type": "string", "minLength": 1},
        "location": {
          "type": "object",
          "required": ["source_start_index", "source_end_index", "paragraph_ids"],
          "properties": {
            "article_no": {"type": ["string", "null"]},
            "heading": {"type": ["string", "null"]},
            "source_start_index": {"type": "integer", "minimum": 0},
            "source_end_index": {"type": "integer", "minimum": 0},
            "paragraph_ids": {"type": "array", "items": {"type": "string"}},
            "table_refs": {"type": "array", "items": {"type": "string"}}
          }
        },
        "plain_summary": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "requires_human_review": {"type": "boolean"},
        "model_id": {"type": ["string", "null"]}
      }
    },
    "riskAssessment": {
      "type": "object",
      "required": [
        "risk_id",
        "clause_id",
        "clause_type",
        "risk_for_client",
        "risk_for_vendor",
        "concern",
        "suggestion",
        "evidence",
        "confidence"
      ],
      "properties": {
        "risk_id": {"type": "string", "minLength": 1},
        "clause_id": {"type": "string", "minLength": 1},
        "clause_type": {"$ref": "#/$defs/clauseType"},
        "risk_for_client": {"$ref": "#/$defs/riskLevel"},
        "risk_for_vendor": {"$ref": "#/$defs/riskLevel"},
        "concern": {"type": "string", "minLength": 1},
        "suggestion": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["clause_id", "quote", "rationale"],
            "properties": {
              "clause_id": {"type": "string", "minLength": 1},
              "quote": {"type": "string", "minLength": 1},
              "rationale": {"type": "string"}
            }
          }
        },
        "source_refs": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "requires_human_review": {"type": "boolean"}
      }
    },
    "clauseType": {
      "enum": [
        "scope",
        "acceptance",
        "payment",
        "ip",
        "warranty",
        "liability",
        "termination",
        "penalty",
        "confidentiality",
        "other"
      ]
    },
    "riskLevel": {
      "enum": ["high", "medium", "low", "none"]
    }
  }
}
