[
  {
    "knowledge_id": "civil-490",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "民法第490條",
    "source_title": "中華民國民法",
    "content": "稱承攬者，謂當事人約定，一方為他方完成一定之工作，他方俟工作完成，給付報酬之契約。約定由承攬人供給材料者，其材料之價額，推定為報酬之一部。",
    "clause_type": null,
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=B0000001&flno=490",
    "effective_date": "2021-01-20",
    "version": 1,
    "status": "reviewed",
    "reviewed_by": "huhantin@gmail.com",
    "updated_at": "2026-08-28"
  },
  {
    "knowledge_id": "civil-492",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "民法第492條",
    "source_title": "中華民國民法",
    "content": "承攬人完成工作，應使其具備約定之品質及無減少或滅失價值或不適於通常或約定使用之瑕疵。",
    "clause_type": "acceptance",
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=B0000001&flno=492",
    "effective_date": "2021-01-20",
    "version": 1,
    "status": "reviewed",
    "reviewed_by": "huhantin@gmail.com",
    "updated_at": "2026-08-28"
  },
  {
    "knowledge_id": "civil-493",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "民法第493條",
    "source_title": "中華民國民法",
    "content": "工作有瑕疵者，定作人得定相當期限，請求承攬人修補之。承攬人不於前項期限內修補者，定作人得自行修補，並得向承攬人請求償還修補必要之費用。如修補所需費用過鉅者，承攬人得拒絕修補，前項規定，不適用之。",
    "clause_type": "warranty",
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=B0000001&flno=493",
    "effective_date": "2021-01-20",
    "version": 1,
    "status": "reviewed",
    "reviewed_by": "huhantin@gmail.com",
    "updated_at": "2026-08-28"
  },
  {
    "knowledge_id": "civil-494",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "民法第494條",
    "source_title": "中華民國民法",
    "content": "承攬人不於前條第一項所定期限內修補瑕疵，或依前條第三項之規定拒絕修補或其瑕疵不能修補者，定作人得解除契約或請求減少報酬。但瑕疵非重要，或所承攬之工作為建築物或其他土地上之工作物者，定作人不得解除契約。",
    "clause_type": "termination",
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=B0000001&flno=494",
    "effective_date": "2021-01-20",
    "version": 1,
    "status": "reviewed",
    "reviewed_by": "huhantin@gmail.com",
    "updated_at": "2026-08-28"
  },
  {
    "knowledge_id": "civil-495",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "民法第495條",
    "source_title": "中華民國民法",
    "content": "因可歸責於承攬人之事由，致工作發生瑕疵者，定作人除依前二條之規定，請求修補或解除契約，或請求減少報酬外，並得請求損害賠償。前項情形，所承攬之工作為建築物或其他土地上之工作物，而其瑕疵重大致不能達使用之目的者，定作人得解除契約。",
    "clause_type": "liability",
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=B0000001&flno=495",
    "effective_date": "2021-01-20",
    "version": 1,
    "status": "reviewed",
    "reviewed_by": "huhantin@gmail.com",
    "updated_at": "2026-08-28"
  },
  {
    "knowledge_id": "civil-498",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "民法第498條",
    "source_title": "中華民國民法",
    "content": "第四百九十三條至第四百九十五條所規定定作人之權利，如其瑕疵自工作交付後經過一年始發見者，不得主張。工作依其性質無須交付者，前項一年之期間，自工作完成時起算。",
    "clause_type": "warranty",
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=B0000001&flno=498",
    "effective_date": "2021-01-20",
    "version": 1,
    "status": "reviewed",
    "reviewed_by": "huhantin@gmail.com",
    "updated_at": "2026-08-28"
  },
  {
    "knowledge_id": "civil-514",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "民法第514條",
    "source_title": "中華民國民法",
    "content": "定作人之瑕疵修補請求權、修補費用償還請求權、減少報酬請求權、損害賠償請求權或契約解除權，均因瑕疵發見後一年間不行使而消滅。承攬人之損害賠償請求權或契約解除權，因其原因發生後，一年間不行使而消滅。",
    "clause_type": "warranty",
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=B0000001&flno=514",
    "effective_date": "2021-01-20",
    "version": 1,
    "status": "reviewed",
    "reviewed_by": "huhantin@gmail.com",
    "updated_at": "2026-08-28"
  },
  {
    "knowledge_id": "civil-229",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "民法第229條",
    "source_title": "中華民國民法",
    "content": "給付有確定期限者，債務人自期限屆滿時起，負遲延責任。給付無確定期限者，債務人於債權人得請求給付時，經其催告而未為給付，自受催告時起，負遲延責任。其經債權人起訴而送達訴狀，或依督促程序送達支付命令，或為其他相類之行為者，與催告有同一之效力。前項催告定有期限者，債務人自期限屆滿時起負遲延責任。",
    "clause_type": null,
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=B0000001&flno=229",
    "effective_date": "2021-01-20",
    "version": 1,
    "status": "reviewed",
    "reviewed_by": "huhantin@gmail.com",
    "updated_at": "2026-08-28"
  },
  {
    "knowledge_id": "civil-231",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "民法第231條",
    "source_title": "中華民國民法",
    "content": "債務人遲延者，債權人得請求其賠償因遲延而生之損害。前項債務人，在遲延中，對於因不可抗力而生之損害，亦應負責。但債務人證明縱不遲延給付，而仍不免發生損害者，不在此限。",
    "clause_type": null,
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=B0000001&flno=231",
    "effective_date": "2021-01-20",
    "version": 1,
    "status": "reviewed",
    "reviewed_by": "huhantin@gmail.com",
    "updated_at": "2026-08-28"
  },
  {
    "knowledge_id": "copyright-12",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "著作權法第12條",
    "source_title": "著作權法",
    "content": "出資聘請他人完成之著作，除前條情形外，以該受聘人為著作人。但契約約定以出資人為著作人者，從其約定。依前項規定，以受聘人為著作人者，其著作財產權依契約約定歸受聘人或出資人享有。未約定著作財產權之歸屬者，其著作財產權歸受聘人享有。依前項規定著作財產權歸受聘人享有者，出資人得利用該著作。",
    "clause_type": "ip",
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=J0070017&flno=12",
    "effective_date": "2022-06-15",
    "version": 1,
    "status": "reviewed",
    "reviewed_by": "huhantin@gmail.com",
    "updated_at": "2026-08-28"
  },
  {
    "knowledge_id": "cpa-12",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "消費者保護法第12條",
    "source_title": "消費者保護法",
    "content": "定型化契約中之條款違反誠信原則，對消費者顯失公平者，無效。定型化契約中之條款有下列情形之一者，推定其顯失公平：一、違反平等互惠原則者。二、條款與其所排除不予適用之任意規定之立法意旨顯相矛盾者。三、契約之主要權利或義務，因受條款之限制，致契約之目的難以達成者。",
    "clause_type": null,
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=J0170001&flno=12",
    "effective_date": "2015-06-17",
    "version": 1,
    "status": "reviewed",
    "reviewed_by": "huhantin@gmail.com",
    "updated_at": "2026-08-28"
  },
  {
    "knowledge_id": "cpa-19",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "消費者保護法第19條",
    "source_title": "消費者保護法",
    "content": "通訊交易或訪問交易之消費者，得於收受商品或接受服務後七日內，以退回商品或書面通知方式解除契約，無須說明理由及負擔任何費用或對價。但通訊交易有合理例外情事者，不在此限。前項但書合理例外情事，由行政院定之。企業經營者於消費者收受商品或接受服務時，未依前條第一項第三款規定提供消費者解除契約相關資訊者，第一項七日期間自提供之次日起算。但自第一項七日期間起算，已逾四個月者，解除權消滅。消費者於第一項及第三項所定期間內，已交運商品或發出書面者，契約視為解除。通訊交易或訪問交易違反本條規定所為之約定，其約定無效。",
    "clause_type": null,
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=J0170001&flno=19",
    "effective_date": "2015-06-17",
    "version": 1,
    "status": "reviewed",
    "reviewed_by": "huhantin@gmail.com",
    "updated_at": "2026-08-28"
  },
  {
    "knowledge_id": "ppa-22-1-9",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "政府採購法第22條第1項第9款",
    "source_title": "政府採購法",
    "content": "機關辦理公告金額以上之採購，符合下列情形之一者，得採限制性招標：九、委託專業服務、技術服務、資訊服務或社會福利服務，經公開客觀評選為優勝者。",
    "clause_type": null,
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=A0030057&flno=22",
    "effective_date": "2019-05-22",
    "version": 1,
    "status": "reviewed",
    "reviewed_by": "huhantin@gmail.com",
    "updated_at": "2026-08-28"
  },
  {
    "knowledge_id": "ppa-72",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "政府採購法第72條",
    "source_title": "政府採購法",
    "content": "機關辦理驗收時應製作紀錄，由參加人員會同簽認。驗收結果與契約、圖說、貨樣規定不符者，應通知廠商限期改善、拆除、重作、退貨或換貨。其驗收結果不符部分非屬重要，而其他部分能先行使用，並經機關檢討認為確有先行使用之必要者，得經機關首長或其授權人員核准，就其他部分辦理驗收並支付部分價金。驗收結果與規定不符，而不妨礙安全及使用需求，亦無減少通常效用或契約預定效用，經機關檢討不必拆換或拆換確有困難者，得於必要時減價收受。其在查核金額以上之採購，應先報經上級機關核准；未達查核金額之採購，應經機關首長或其授權人員核准。驗收人對工程、財物隱蔽部分，於必要時得拆驗或化驗。",
    "clause_type": "acceptance",
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=A0030057&flno=72",
    "effective_date": "2019-05-22",
    "version": 1,
    "status": "reviewed",
    "reviewed_by": "huhantin@gmail.com",
    "updated_at": "2026-08-28"
  },
  {
    "knowledge_id": "pdpa-4",
    "corpus": "legal_sources",
    "parent_id": null,
    "title": "個人資料保護法第4條",
    "source_title": "個人資料保護法",
    "content": "受公務機關或非公務機關委託蒐集、處理或利用個人資料者，於本法適用範圍內，視同委託機關。",
    "clause_type": "confidentiality",
    "jurisdiction": "TW",
    "source_url": "https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=I0050021&flno=4",
    "effective_date": "2023-05-31",
